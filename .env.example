# ---- Docker Compose deployment settings. Copy to .env before `docker compose up`. ----

ENVIRONMENT=production

# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL credentials
POSTGRES_USER=tourist
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=tourist_safety

# Where the frontend is served (used for CORS)
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080

# Trusted Host header(s). Set to your domain in real deployments, e.g. example.com
ALLOWED_HOSTS=*

# Demo data is OFF by default. To seed a demo deployment, set all three of
#   SEED_ON_START=true, SEED_FORCE=true
# and (optionally) strong SEED_*_PASSWORD values. Leave the passwords empty to
# get random ones printed once in the backend logs. Weak/demo passwords such as
# admin123 are rejected at startup in production.
SEED_ON_START=false
SEED_FORCE=false
SEED_ADMIN_PASSWORD=
SEED_TOURIST_PASSWORD=
SEED_RESPONDER_PASSWORD=

# ---- Home server for the Android app (README: "Home server") ----
# With Tailscale Funnel the public address looks like https://my-pc.tail1234.ts.net
# PUBLIC_BASE_URL=https://my-pc.tail1234.ts.net
# CORS_ORIGINS=https://my-pc.tail1234.ts.net,https://localhost   (https://localhost = the Android app)
# ALLOWED_HOSTS=my-pc.tail1234.ts.net,localhost
# REFRESH_COOKIE_SECURE=true
# Firebase service-account key saved as ./secrets/firebase.json:
# FCM_CREDENTIALS_FILE=/app/secrets/firebase.json

# ---- Password reset emails (README: "Password reset emails") ----
# Free with Gmail (~500 emails/day). Turn on 2-Step Verification for the Google
# account, create an App Password (Google Account -> Security -> App passwords)
# and put it here -- NOT your normal Gmail password. Left empty, reset codes are
# not emailed (and, in production, never written to the logs either).
# SMTP_USERNAME=your.address@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# Optional: SMTP_FROM (defaults to SMTP_USERNAME), SMTP_FROM_NAME (default MUSAFIR),
# SMTP_HOST / SMTP_PORT (default smtp.gmail.com / 587) for another provider.

# ---- Place search (Walk-Me-Home destination, itinerary places) ----
# Without a key, search uses free OpenStreetMap data (Photon + Nominatim),
# which misses many small shops/hotels. With a Google Maps Platform key
# (enable "Places API (New)" and "Geocoding API"; restrict the key to those
# APIs), practically every place is found. Google gives a free monthly quota.
# GOOGLE_MAPS_API_KEY=
