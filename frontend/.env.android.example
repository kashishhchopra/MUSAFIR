# Settings baked into the Android app. Copy to .env.android and replace the
# host with your home server's Tailscale Funnel address (README: "Android app").
VITE_API_BASE=https://my-pc.tail1234.ts.net/api
VITE_WS_ORIGIN=wss://my-pc.tail1234.ts.net
# Real GPS on the phone (the default "true" sends a fake random walk for demos).
VITE_SIMULATE_GPS=false
VITE_SHOW_DEMO=false
# How often a moving phone sends its location (ms). Higher = less battery.
VITE_TRACK_INTERVAL_MS=15000
