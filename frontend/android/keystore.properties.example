# Copy to keystore.properties (gitignored) after creating the key with:
#   keytool -genkey -v -keystore musafir.jks -keyalg RSA -keysize 2048 -validity 10000 -alias musafir
# storeFile is relative to this android/ folder. Back up musafir.jks and the passwords:
# without them you can't install updates over the existing app.
storeFile=musafir.jks
storePassword=CHANGE_ME
keyAlias=musafir
keyPassword=CHANGE_ME
