# ---- Copy to .env and adjust. NEVER commit the real .env. ----

# development | production  (production enforces a strong SECRET_KEY & hides docs)
ENVIRONMENT=development

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. Leave blank in dev to auto-generate an ephemeral key.
SECRET_KEY=

# SQLite for dev; PostgreSQL for prod, e.g.
#   postgresql+psycopg://user:password@db:5432/tourist_safety
DATABASE_URL=sqlite:///./tourist_safety.db

# JWT lifetimes (minutes). Access is deliberately short -- see
# app/api/auth.py for why refresh tokens carry revocation instead.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Refresh token is set as an httpOnly cookie (never JS-readable). Secure
# should be true behind HTTPS -- i.e. always in a real deployment.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=strict

# Scheduler / cross-worker job locking (see app/core/joblock.py)
SCHEDULER_ENABLED=true
JOB_LOCK_TTL_SECONDS=120
TOKEN_PURGE_TICK_SECONDS=3600

# Demo account passwords for `python -m app.scripts.seed`. Leave unset to
# get a random password printed once. The script refuses to run against
# ENVIRONMENT=production unless SEED_FORCE=true.
SEED_ADMIN_PASSWORD=
SEED_TOURIST_PASSWORD=
SEED_RESPONDER_PASSWORD=
SEED_FORCE=false

# Outbound notifications (password-reset codes, SOS alerts to emergency
# contacts). "console" logs instead of sending -- no external service
# needed. See app/services/notifications.py to add a real backend.
NOTIFICATION_CHANNEL=console
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Comma-separated allowed CORS origins (the frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated trusted Host headers. Use explicit hosts in production, e.g.
#   api.example.com,example.com   ('*' disables the check — dev only)
ALLOWED_HOSTS=*

# Rate limiting
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
GLOBAL_RATE_LIMIT=240
GLOBAL_RATE_WINDOW_SECONDS=60

# Password policy
MIN_PASSWORD_LENGTH=8

# Domain thresholds
ROUTE_DEVIATION_THRESHOLD_M=2000
ANOMALY_INCIDENT_DEDUPE_MINUTES=5

# Map defaults surfaced to the frontend via /api/config
MAP_CENTER_LAT=26.1445
MAP_CENTER_LNG=91.7362
MAP_DEFAULT_ZOOM=13

# ML artifacts
ML_MODELS_DIR=ml_models

# Weather: the safety-score input (services/weather.py) AND the real-time
# Disaster & Weather Alert Feed's weather-condition hazard detector
# (services/disaster.py::weather_condition_advisories -- extreme heat/cold,
# thunderstorm, heavy rain, dense fog, derived from actual current
# conditions at each zone). Leave blank and the app uses Open-Meteo instead --
# genuine current conditions, free, no key or signup. The deterministic mock is
# used ONLY if no weather service at all is reachable (fully offline).
# Optional: a free OpenWeatherMap key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Public holidays (Smart Trip Planner, Crowd & Queue Forecast, Festival &
# Local Event Intelligence): the Calendarific API (https://calendarific.com).
# Free tier, but a signup + key is required (Nager.Date, which needs no key
# at all, does not cover India). Leave blank and this signal is simply
# absent everywhere it's used -- never a fabricated holiday.
# Get a free key at https://calendarific.com/signup
CALENDARIFIC_API_KEY=
HOLIDAYS_COUNTRY_CODE=IN

# Discovery (hidden spots / regional food / homestays): live lookups from
# the free public OpenStreetMap Overpass API -- no key/signup required.
# Set to false to serve database-only results (e.g. a fully offline demo
# venue with no outbound network access at all).
DISCOVERY_LIVE_ENABLED=true
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# External services: maps / translation / speech. All optional -- with none set,
# the app still uses REAL free services: OpenStreetMap Nominatim for place
# search/geocoding, the OSRM routers at routing.openstreetmap.de for road routing
# (driving/walking/cycling, with turn-by-turn and the route line), MyMemory for
# translation. Setting the keys below upgrades quality/limits and unlocks
# public-transport routing. A straight-line estimate (clearly labelled) is used
# only when even the free services are unreachable. See app/services/maps.py and
# app/services/translation.py.
#   Google Maps Platform -- enable the "Geocoding API" and "Directions API":
#     https://console.cloud.google.com/google/maps-apis
#   Required for the "Public transport" travel mode; without it that mode is
#   simply not offered (never faked).
GOOGLE_MAPS_API_KEY=
#   Google Cloud Translation API (enable "Cloud Translation API"):
#     https://cloud.google.com/translate
GOOGLE_TRANSLATE_API_KEY=
#   Any cloud speech-to-text provider. Left blank, the frontend's own
#   browser-native Web Speech API is used instead (see
#   frontend/src/hooks/useSpeechRecognition.js) -- no backend call needed.
SPEECH_TO_TEXT_API_KEY=
#   Any cloud text-to-speech provider. Left blank, the frontend's own
#   browser-native SpeechSynthesis API is used instead.
TEXT_TO_SPEECH_API_KEY=

# ---- open-ended assistant (see app/services/llm.py) ----
# Safety-critical questions ("nearest hospital") are always answered from
# real database rows by the intent router. This backs EVERYTHING ELSE, so
# the assistant can answer any question instead of a fixed command list.
# Default "auto": a cloud key below if one is set, otherwise a local Ollama
# model, otherwise the assistant just says what it can do.
LLM_ENABLED=true
# auto | ollama | openai | anthropic | none
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=250
LLM_TEMPERATURE=0.3
#   Local model -- free, no API key, nothing leaves the machine.
#   Install: https://ollama.com  then:  ollama pull llama3.2 && ollama serve
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
#   Optional cloud models -- better answers, but cost money and send the
#   question (plus the tourist's context) to a third party.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Live-feed fallback ladder (see app/services/feeds.py). False = snapshot-
# only, no network calls at all -- useful at a venue with no reliable internet.
FEEDS_ENABLED=true

# Disaster advisory feed: "" (default) runs the built-in deterministic
# simulator. "cap" polls DISASTER_FEED_URL for a real CAP 1.2 feed (see
# app/services/cap.py) and falls back to the simulator if it's unreachable.
DISASTER_FEED_PROVIDER=
DISASTER_FEED_URL=

# ---- CCTV network (services/cctv.py) ----
# Leave CCTV_PROVIDER empty (default) to use the database as the only source
# of cameras: an operator registers each one, with its real stream URL,
# through POST /api/police-network/cameras. Nothing is ever auto-populated
# with invented cameras -- with no cameras registered, /api/cctv returns an
# empty list and the dashboard says there are no feeds available.
#
# Set CCTV_PROVIDER=json plus CCTV_PROVIDER_URL to additionally import
# camera metadata from an external open-data/public-camera feed that returns
# a JSON list of {name, latitude, longitude, streamUrl}. Any credential the
# feed needs stays here, server-side -- never in frontend code.
CCTV_PROVIDER=
CCTV_PROVIDER_URL=
CCTV_API_KEY=
# Bounds on the live-status probe and how long its result is reused.
CCTV_PROBE_TIMEOUT_SECONDS=4.0
CCTV_STATUS_CACHE_SECONDS=30
# How often the dashboard re-polls camera status, in seconds.
CCTV_REFRESH_INTERVAL_SECONDS=30

# Simulation Core (admin-only virtual tourists + scripted events, see README).
# Single-process clock: keep WEB_CONCURRENCY=1. Set false to disable in a real deployment.
SIMULATION_ENABLED=true

# ---- Push & SMS alerts (README: "Push & SMS Alerts") ----
# Frontend origin, used for deep links inside push/SMS text.
PUBLIC_BASE_URL=http://localhost:5173
# Web Push (VAPID). Generate once:  python -m app.scripts.generate_vapid_keys
# Left empty in development the server creates + persists a key pair itself
# (.vapid_keys.json); in production push stays OFF until these are set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com

# Native iOS push (APNs). Needs a paid Apple Developer account -> Keys -> APNs (.p8).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.musafir.app
APNS_AUTH_KEY=            # contents of the .p8 file (use \n for line breaks)
APNS_USE_SANDBOX=true     # false for App Store / TestFlight builds
# SMS: "console" (default) logs only -- rows show as "Simulated", nothing is texted.
# "twilio" sends real SMS; set the three TWILIO_* values (FROM_NUMBER or MESSAGING_SERVICE_SID).
NOTIFICATION_CHANNEL=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SMS_DEFAULT_COUNTRY_CODE=+91
# While testing, restrict SMS to these numbers (comma-separated E.164) so a demo/seed contact can never be texted.
SMS_ALLOWLIST=

# ---- Fall & crash detection (see README "Fall & Crash Detection") ----
# Defaults live in app/core/config.py; uncomment to override.
# FALL_DETECTION_ENABLED=true
# FALL_COUNTDOWN_SECONDS=30          # the "I am safe" window (server-owned clock)
# FALL_CONFIRM_GRACE_SECONDS=5       # extra time before the sweep raises the incident
# FALL_SWEEP_TICK_SECONDS=5
# FALL_DEDUPE_WINDOW_SECONDS=120
# FALL_SIMULATION_ENABLED=true       # demo mode -- set false in production
# Detector thresholds (served to the browser): FALL_FREEFALL_G, FALL_IMPACT_G, FALL_CRASH_IMPACT_G,
# FALL_CRASH_MIN_SPEED_KMH, FALL_STILLNESS_MS, FALL_DETECTOR_COOLDOWN_SECONDS, ...

# ---- Walk-Me-Home (monitored journey; reuses the check-in engine) ----
# WALKHOME_ENABLED=true
# WALKHOME_DEFAULT_DURATION_MINUTES=30   # MIN/MAX_DURATION_MINUTES bound it (2..720)
# WALKHOME_DEFAULT_INTERVAL_MINUTES=10   # check-in interval; MIN/MAX_INTERVAL_MINUTES (1..120)
# WALKHOME_DEFAULT_GRACE_MINUTES=5       # time to respond after a missed check-in before an incident
# WALKHOME_MAX_EXTENSIONS=3              # "add time" uses per journey; WALKHOME_MAX_EXTENSION_MINUTES=60
# WALKHOME_LOCATION_INTERVAL_SECONDS=15  # how often the open app shares its position
# WALKHOME_LOCATION_STALE_SECONDS=120    # guardians see "stale", not "live", after this
# WALKHOME_ESCALATION_SEVERITY=critical

# ---- Intelligent response management (all optional; demonstration defaults) ----
# RESPONSE_MANAGEMENT_ENABLED=true
# RESPONSE_TARGET_CRITICAL_SECONDS=60
# RESPONSE_TARGET_HIGH_SECONDS=180
# RESPONSE_TARGET_MEDIUM_SECONDS=300
# RESPONSE_TARGET_LOW_SECONDS=600
# RESPONSE_STAGE2_SECONDS=120
# RESPONSE_GLOBAL_TIMEOUT_SECONDS=1800
# RESPONSE_STAGE1_AUDIENCE=assigned_unit
# RESPONSE_STAGE2_AUDIENCE=responders
# RESPONSE_STAGE3_AUDIENCE=admins
# RESPONSE_WARNING_SECONDS=0
# SEVERITY_SOURCE_FLOOR_ENABLED=true

# --- Emergency Medical Profile (QR) -------------------------------------
# MEDICAL_QR_TOKEN_TTL_DAYS=0              # 0 = tokens do not expire on their own (the trip end still does)
# MEDICAL_ACCESS_RATE_LIMIT=30             # medical lookups per responder per window
# MEDICAL_ACCESS_RATE_WINDOW_SECONDS=60
# MEDICAL_FAILED_LOOKUP_LIMIT=6            # failed lookups before a responder/IP is locked out
# MEDICAL_FAILED_LOOKUP_WINDOW_SECONDS=300
# MEDICAL_ACCESS_PURPOSE_REQUIRED=false
# MEDICAL_ACCESS_PURPOSES=["medical_emergency","accident","unresponsive_person","routine_verification","other"]

# ---- Privacy management (DPDP-oriented) -- all legal/operational values are CONFIG; confirm with legal review ----
# PRIVACY_NOTICE_VERSION=1.0
# PRIVACY_CONTACT_EMAIL=privacy@your-domain.example     # shown to users for grievances
# PRIVACY_GRIEVANCE_RESPONSE_DAYS=30                    # internal target, not a statutory figure
# PRIVACY_EXPORT_DIR=privacy_exports                    # private directory; files are encrypted at rest
# PRIVACY_EXPORT_TTL_HOURS=24
# PRIVACY_EXPORT_MAX_PER_DAY=5
# PRIVACY_DELETION_GRACE_HOURS=0                        # delay between confirming deletion and erasing
# PRIVACY_DELETION_MAX_ATTEMPTS=5
# PRIVACY_EXTERNAL_PROCESSORS=[{"name":"SMS gateway","contact":"dpo@vendor.example"}]
# PRIVACY_BACKUP_ROTATION_DAYS=0                        # 0 = not configured
# PRIVACY_REGISTRATION_CONSENT_REQUIRED=false           # true = API also requires the two acknowledgements
# PRIVACY_PURPOSES / PRIVACY_RETENTION_DEFAULTS         # JSON; see app/core/config.py for the shape
